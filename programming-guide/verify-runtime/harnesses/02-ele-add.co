// Block F03-S03 "A complete element-wise addition"
// Published body maps 4x8 elements straight onto parallel-by instances; the
// GCU target caps the thread-level parallel-by count, so the port iterates
// inside a single thread.
#include <cstdio>

__co__ auto ele_add(s32 [4, 8] lhs, s32 [4, 8] rhs) {
  s32 [lhs.span] output;
  parallel by 1 : thread {
    local s32 [4, 8] lhs_l;
    local s32 [4, 8] rhs_l;
    shared s32 [4, 8] out_s;
    dma.copy lhs => lhs_l;
    dma.copy rhs => rhs_l;
    foreach {i, j} in [4, 8] {
      out_s.at(i, j) = lhs_l.at(i, j) + rhs_l.at(i, j);
    }
    dma.copy out_s => output;
  }
  return output;
}

int main() {
  auto lhs = choreo::make_spandata<choreo::s32, 2>({4, 8});
  auto rhs = choreo::make_spandata<choreo::s32, 2>({4, 8});
  lhs.fill_random(-10, 10);
  rhs.fill_random(-10, 10);
  auto res = ele_add(lhs.view(), rhs.view());
  int bad = 0;
  for (int i = 0; i < 4; ++i)
    for (int j = 0; j < 8; ++j)
      if (res[i][j] != lhs[i][j] + rhs[i][j]) ++bad;
  printf("bad=%d\n", bad);
  return bad != 0;
}
